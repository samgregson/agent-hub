{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.dev/contracts/foundation.schema.json",
  "title": "FoundationContracts",
  "description": "Registry of the language-neutral Agent Hub foundation contracts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agentRun": { "$ref": "#/$defs/AgentRun" },
    "artifactCatalog": { "$ref": "#/$defs/ArtifactCatalog" },
    "artifactDocument": { "$ref": "#/$defs/ArtifactDocument" },
    "error": { "$ref": "#/$defs/ErrorEnvelope" },
    "projectFilePreview": { "$ref": "#/$defs/ProjectFilePreview" },
    "projectFileCatalog": { "$ref": "#/$defs/ProjectFileCatalog" },
    "scratchFilePreview": { "$ref": "#/$defs/ScratchFilePreview" },
    "project": { "$ref": "#/$defs/Project" },
    "thread": { "$ref": "#/$defs/Thread" }
  },
  "$defs": {
    "EntityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "An opaque stable Agent Hub identifier. Clients must not parse it."
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "requestId", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "requestId": { "$ref": "#/$defs/EntityId" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      }
    },
    "ArtifactSchemaBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "ArtifactPluginBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "ArtifactProvenanceActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["agentRun", "userAction"] },
        "threadId": { "$ref": "#/$defs/EntityId" },
        "runId": { "$ref": "#/$defs/EntityId" },
        "userActionId": { "$ref": "#/$defs/EntityId" }
      }
    },
    "ArtifactProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "lastChangedBy"],
      "properties": {
        "createdBy": { "$ref": "#/$defs/ArtifactProvenanceActor" },
        "lastChangedBy": { "$ref": "#/$defs/ArtifactProvenanceActor" }
      }
    },
    "ArtifactRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "targetArtifactId"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "targetArtifactId": { "$ref": "#/$defs/EntityId" }
      }
    },
    "ArtifactEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "documentVersion",
        "title",
        "schema",
        "plugin",
        "provenance",
        "relations"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "type": { "type": "string", "minLength": 1 },
        "documentVersion": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": { "type": "string", "maxLength": 2000 },
        "schema": { "$ref": "#/$defs/ArtifactSchemaBinding" },
        "plugin": { "$ref": "#/$defs/ArtifactPluginBinding" },
        "provenance": { "$ref": "#/$defs/ArtifactProvenance" },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactRelation" }
        }
      }
    },
    "ArtifactDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "payload"],
      "properties": {
        "artifact": { "$ref": "#/$defs/ArtifactEnvelope" },
        "payload": { "type": "object", "additionalProperties": true }
      }
    },
    "ArtifactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "documentVersion", "title", "pluginId", "pluginVersion"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "type": { "type": "string", "minLength": 1 },
        "documentVersion": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "summary": { "type": "string", "maxLength": 2000 },
        "pluginId": { "type": "string", "minLength": 1 },
        "pluginVersion": { "type": "string", "minLength": 1 }
      }
    },
    "ArtifactCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/ArtifactSummary" }
        }
      }
    },
    "AgentRunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "interrupted",
        "cancelling",
        "cancelled",
        "succeeded",
        "failed"
      ]
    },
    "AgentRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "threadId", "status", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "threadId": { "$ref": "#/$defs/EntityId" },
        "status": { "$ref": "#/$defs/AgentRunStatus" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "error": { "$ref": "#/$defs/ErrorEnvelope" }
      }
    },
    "ProjectFilePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1032 },
        "content": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "ProjectFileCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProjectFileSummary" }
        }
      }
    },
    "ProjectFileSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "updatedAt"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1032 },
        "version": { "type": "integer", "minimum": 1 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ScratchFilePreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1032 },
        "content": { "type": "string" }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "title", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/EntityId" },
        "projectId": { "$ref": "#/$defs/EntityId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
