{
  "name": "@agent-hub/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "next start --hostname 0.0.0.0",
    "test": "tsc --project tsconfig.test.json && node --test .test-build/workspace/_state.test.js .test-build/workspace/_thread-title.test.js .test-build/agent-ui/_history.test.js .test-build/agent-ui/_project-links.test.js .test-build/agent-ui/_ag-ui-contract.test.js .test-build/agent-ui/_approval.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@ag-ui/core": "catalog:",
    "@assistant-ui/react": "catalog:",
    "@assistant-ui/react-ag-ui": "catalog:",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
